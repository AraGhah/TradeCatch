# Deployment environment: production | staging | development
# Installation approval rollout: OFF until exact existing origins are inventoried.
# See docs/INSTALLATION_APPROVAL.md. Never put credentials in NEXT_PUBLIC_*.
INSTALLATION_ENFORCEMENT=off
INSTALLATION_INVENTORY_CONFIRMED=
INSTALLATION_ID=
INSTALLATION_CREDENTIAL=
# local only on the controlled authority backend; remote on licensed Workers.
INSTALLATION_AUTHORITY_MODE=remote
# Staging uses a separate Cloudflare Worker (tradecatch-staging), a separate
# Postgres DATABASE_URL, dry-run SMS by default, and the Demo Mode banner.
# See docs/STAGING_ENVIRONMENT.md. Never set staging flags on the live Worker.
TRADECATCH_ENV=
# Mirrored for client UI (banner). Set to staging on the staging Worker.
NEXT_PUBLIC_TRADECATCH_ENV=
# Force the sticky Demo Mode / Staging indicator + robots noindex.
NEXT_PUBLIC_DEMO_MODE=
# HTTP Basic gate for staging when Cloudflare Access is not configured.
# Both must be set; ignored outside staging/demo mode.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# Public site URL used for canonical tags, hreflang, sitemap, and robots.txt
# Staging example: https://staging.tradecatch.ca
NEXT_PUBLIC_SITE_URL=https://tradecatch.ca

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Analytics only loads in the browser after the visitor accepts the cookie banner.
# Conversion events fired when consented: cta_click, audit_step_completed,
# audit_form_submitted, generate_lead.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend (https://resend.com) — audit-request confirmation + internal notification.
# Strongly recommended before a public audit-form demo. If unset, submissions
# are accepted and logged, but confirmation/internal notification email is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
RESEND_NOTIFY_EMAIL=you@example.com

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Site key is public (browser); secret key stays server-only.
# Strongly recommended before public traffic. If unset, verification is skipped
# with a warning; the health route reports the missing optional integration.
# Never commit real keys. If keys were ever committed, rotate them in the
# Cloudflare dashboard before relying on Turnstile in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional external destination for TradeCatch's own sales leads.
# Native sales CRM uses DATABASE_URL and requires neither of these webhook settings.
# When configured, accepted booking leads also queue external forwarding.
# Contractor organization integrations use their own CRM settings, never this URL.
LEADS_WEBHOOK_URL=
# Optional bearer token sent as Authorization: Bearer …
LEADS_WEBHOOK_SECRET=

# Optional calendar booking link shown after a successful audit request
# (Cal.com, Calendly, Google Appointment schedules, etc.).
NEXT_PUBLIC_CALENDAR_URL=

# Optional error monitoring webhook (Sentry/Better Stack/Slack/Discord incoming URL).
# Used by /api/client-error and server-side reportError(). Apply provider-side quotas.
ERROR_WEBHOOK_URL=
# Book-audit notifications: retries run every minute; administrator alerts use
# ERROR_WEBHOOK_URL after three failed delivery attempts and are retried too.
# Dedicated bearer secret for this retry worker only (or use the ops/cron secret).
BOOK_AUDIT_RETRY_SECRET=
# Optional build stamp attached to client-error reports.
NEXT_PUBLIC_BUILD_ID=
# Cloudflare only: set to 1 after confirming the public origin is reachable only
# through Cloudflare. This trusts CF-Connecting-IP for per-client rate limits.
CF_TRUSTED=
# Other reverse proxies only: set to 1 when the proxy sanitizes
# X-Forwarded-For / X-Real-IP. Vercel is detected automatically.
TRUST_PROXY_HEADERS=

# Optional Upstash Redis (REST) for shared rate-limit + idempotency across
# multiple serverless instances. Without these, limits are per-instance only.
# https://upstash.com/docs/redis/overall/getstarted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SaaS portal (magic-link auth). Required to sign session cookies for /app and to
# seal stored credentials (MFA seeds, OAuth tokens).
# Use a dedicated random value of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# It falls back to MISSED_CALL_OPS_SECRET if unset, which couples the two; /api/health
# reports that as a security warning. Rotating it signs everyone out.
AUTH_SECRET=
# Set to 1 only on a loopback, non-production harness to return a clickable
# magic-link token when email delivery is unavailable.
SAAS_DEV_LOGIN=
# Optional: force durable SaaS store (otherwise uses MISSED_CALL_DURABLE_STORE).
SAAS_DURABLE_STORE=
# Comma-separated emails allowed into /admin (demo business management).
# Users can also be flagged with platform_role=admin in tc_users.
TRADECATCH_ADMIN_EMAILS=

# --- Module A: missed-call recovery (Twilio) ---
# Account credentials for outbound SMS. If unset, SMS is logged as dry-run.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public origin Twilio uses when signing webhooks (no trailing slash), e.g. https://tradecatch.ca
MISSED_CALL_PUBLIC_WEBHOOK_BASE=
# Set to 1 to skip X-Twilio-Signature checks (never in real production traffic).
MISSED_CALL_SKIP_TWILIO_VALIDATE=
# Local/manual test switch for /api/missed-call/sandbox. Production readiness
# rejects deployments with this enabled.
MISSED_CALL_SANDBOX=
# Comma-separated backup technician phones (escalated in order).
MISSED_CALL_TECH_BACKUP_PHONES=
MISSED_CALL_TECH_OWNER_PHONE=
MISSED_CALL_TECH_OWNER_NAME=
MISSED_CALL_HUMAN_REVIEW_PHONE=
MISSED_CALL_TIMEZONE=America/Toronto
# Full JSON ClientAccount override (takes precedence over the individual vars).
MISSED_CALL_CLIENT_CONFIG_JSON=
# Set to 1 only for intentional demo routing in non-production-like hosts.
MISSED_CALL_ALLOW_DEMO=
# Set to dry-run to force the explicit fake SMS adapter outside production.
# Production never returns fake SM_dry_* success SIDs — missing Twilio throws.
MISSED_CALL_SMS_MODE=
# Optional Postgres URL for the durable MissedCallStore adapter.
# Run `npm run db:schema` to apply the base schema and every migration through
# 005_crm_webhook_dlq, then set MISSED_CALL_DURABLE_STORE=1.
DATABASE_URL=
# Set to 1 only after `npm run db:schema` succeeds and createPostgresStore() should run.
MISSED_CALL_DURABLE_STORE=
# Bearer token for Module A ops APIs (leads, escalations/tick, sandbox).
# Also accepts CRON_SECRET as a scheduler compatibility alias.
# REQUIRED in production — endpoints return 401 without a matching bearer.
MISSED_CALL_OPS_SECRET=
# Optional compatibility alias used by the scheduler when the ops secret is unset.
CRON_SECRET=
# Single-tenant v1 client config
MISSED_CALL_CLIENT_ID=client_demo
MISSED_CALL_SMS_FROM=+15145550100
MISSED_CALL_TECH_PHONE=+15145550199
MISSED_CALL_TECH_NAME=Technicien de garde
MISSED_CALL_CONTRACTOR_NAME=Nord Plomberie

# --- AI Receptionist (inbound call answering) ---
# Preferred Task 4 webhooks (aliases of the step routes below):
#   POST {MISSED_CALL_PUBLIC_WEBHOOK_BASE}/api/webhooks/twilio/voice
#   POST {MISSED_CALL_PUBLIC_WEBHOOK_BASE}/api/webhooks/twilio/status
# Legacy / step callbacks:
#   POST {MISSED_CALL_PUBLIC_WEBHOOK_BASE}/api/twilio/voice/receptionist/incoming
#   POST {MISSED_CALL_PUBLIC_WEBHOOK_BASE}/api/twilio/voice/receptionist/status
# Requires the durable store in production (DATABASE_URL + MISSED_CALL_DURABLE_STORE=1,
# `npm run db:schema` applies through 009_phone_call_events).
#
# Option 1 — derive one profile from the Module A client (name, hours, technicians):
RECEPTIONIST_ENABLED=
# Optional overrides for the derived profile.
RECEPTIONIST_PHONE_NUMBER=
RECEPTIONIST_EMERGENCY_PHONE=
RECEPTIONIST_FALLBACK_PHONE=
RECEPTIONIST_NOTIFY_EMAIL=
RECEPTIONIST_NOTIFY_SMS=
RECEPTIONIST_WEBHOOK_URL=
RECEPTIONIST_WEBHOOK_SECRET=
# Option 2 — full control: one JSON object or an array (one per business/number).
# See src/product/receptionist/README.md for every field (hours, FAQ, routing…).
RECEPTIONIST_CONFIG_JSON=
# Conversation brain. Without any key the deterministic rule brain answers calls.
#   anthropic (default when ANTHROPIC_API_KEY is set) | openai (OpenAI-compatible,
#   incl. self-hosted Ollama / vLLM via RECEPTIONIST_LLM_BASE_URL) | none
RECEPTIONIST_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RECEPTIONIST_LLM_BASE_URL=
RECEPTIONIST_LLM_MODEL=
# Per-turn model timeout; on timeout the rule brain answers instead.
RECEPTIONIST_LLM_TIMEOUT_MS=4500
# Language menu: every call opens in French ("...restez en ligne. For English,
# press 1."). Seconds to wait for a key before carrying on in French (2-10).
RECEPTIONIST_LANGUAGE_SELECT_TIMEOUT_SECONDS=3
# Pacing markup (slower numbers/addresses, short pauses) on Polly/Google voices.
# Set to 0 if a voice rejects it and the caller hears silence.
RECEPTIONIST_SSML=
# Twilio <Gather> speech recognition. Leave empty for Twilio's defaults; change
# only after comparing real calls. Models: default, numbers_and_commands,
# phone_call, experimental_conversations, experimental_utterances,
# deepgram_nova-2, deepgram_nova-3.
RECEPTIONIST_GATHER_SPEECH_MODEL=
RECEPTIONIST_GATHER_ENHANCED=
# "auto" or 1-10 seconds of quiet that ends the caller's turn.
RECEPTIONIST_GATHER_SPEECH_TIMEOUT=auto
# Seconds of total silence before Twilio gives up on a turn (3-15).
RECEPTIONIST_GATHER_TIMEOUT_SECONDS=6
RECEPTIONIST_GATHER_PROFANITY_FILTER=
# Recognizer confidence (0-0.9) below which a free-form answer is repeated back
# for clarification, at most twice per question.
RECEPTIONIST_MIN_ASR_CONFIDENCE=0.5
# Public website demo on /receptionist#try-it (POST /api/receptionist/demo). On
# by default; it has no side effects (no SMS, email, phone call, database or
# LLM) and needs no secret. Set to 0 to turn the demo off.
RECEPTIONIST_DEMO=
# Spoken replies on that demo. English voice y0s2ExEMuum3muUnA6Zd, French
# voice j9RedbMRSNQ74PyikQwD. Without this key the browser voice is used.
# Also powers Custom AI Voice Cloning (Receptionist Plus, /app/receptionist/voice):
# creating, previewing and deleting a business's cloned voice. Without it that
# feature reports itself unavailable and calls keep the standard voice. The LiveKit
# agent needs the same key as its own secret (agents/receptionist/.env.example).
ELEVENLABS_API_KEY=
# Speech-to-text model that checks the spoken verification phrase (default scribe_v2).
ELEVENLABS_STT_MODEL=

# --- Email automation (Growth plan) ---
# Sender used for follow-up sequences; falls back to RESEND_FROM_EMAIL.
# Must be a Resend-verified domain. Unsubscribe links are signed with AUTH_SECRET.
EMAIL_AUTOMATION_FROM=

# --- Gmail receiving (read-only) ---
# Full setup walkthrough: docs/GMAIL_SETUP.md
# OAuth client with the Gmail API enabled. The only scope requested is gmail.readonly.
# Redirect URI must be {NEXT_PUBLIC_SITE_URL}/api/app/gmail/callback
# Tokens are sealed (AES-256-GCM) with AUTH_SECRET; rotating AUTH_SECRET asks users to reconnect.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=
# Optional push (faster than polling): a Pub/Sub topic and authenticated push identity.
# Pub/Sub OIDC bearer authentication. Never put credentials in the callback URL.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
# Mailboxes the scheduled fallback (/api/gmail/sync/tick) checks per run (default 2, max 25).
GMAIL_CRON_BATCH=
# Dedicated secret for the every-minute scheduler (five-minute mailbox freshness).
GMAIL_SYNC_SECRET=

# --- Webhook authentication ---
# Stripe: signing secret (whsec_...) of the endpoint /api/webhooks/stripe. Events are
# accepted only with a valid signature inside a 5-minute window, once per event id.
STRIPE_WEBHOOK_SECRET=
# Live API key and trusted recurring Price IDs (comma-separated for legacy prices).
# Never infer a paid plan from an email, amount, or client-controlled metadata.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_RECEPTIONIST=
# One-time installation-fee Price IDs, one per plan (self-serve checkout; see
# stripe-checkout.ts). Separate from the recurring prices above.
STRIPE_PRICE_INSTALL_STARTER=
STRIPE_PRICE_INSTALL_GROWTH=
STRIPE_PRICE_INSTALL_RECEPTIONIST=
# Separate test endpoint secret/key/prices. Test events may only update demo orgs.
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PRICE_STARTER=
STRIPE_TEST_PRICE_GROWTH=
STRIPE_TEST_PRICE_RECEPTIONIST=
STRIPE_TEST_PRICE_INSTALL_STARTER=
STRIPE_TEST_PRICE_INSTALL_GROWTH=
STRIPE_TEST_PRICE_INSTALL_RECEPTIONIST=
# Google Calendar change notifications (/api/webhooks/google-calendar): the same value
# must be sent by Google as the channel token. Long and random; unset refuses everything.
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Optional mode-specific Billing Portal configuration IDs (bpc_...).
# Otherwise Stripe uses its matching-mode default configuration.
STRIPE_BILLING_PORTAL_CONFIGURATION=
STRIPE_TEST_BILLING_PORTAL_CONFIGURATION=

# Dedicated authorization for /api/monitoring/tick; never use provider API keys.
MONITORING_SECRET=
# Receives real health incident alerts; falls back to RESEND_NOTIFY_EMAIL.
ADMIN_ALERT_EMAIL=
# Explicit enrollment for the Google Calendar technical pilot (comma-separated organization IDs).
# Empty disables live Google Calendar access. Outlook has no adapter and remains planned.
GOOGLE_CALENDAR_PILOT_ORG_IDS=
