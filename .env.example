# Public site URL used for canonical tags, hreflang, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://tradecatch.ca

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Analytics only loads in the browser after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend (https://resend.com) — sends the audit-request confirmation email to
# the lead and an internal notification. If unset, /api/book-audit still
# accepts and logs submissions but skips sending email (see src/lib/email.ts).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_NOTIFY_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Site key is public (shipped to the browser); secret key stays server-only.
# If TURNSTILE_SECRET_KEY is unset, server-side verification is skipped with
# a warning log — see src/lib/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
