# Public site URL used for canonical tags, hreflang, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://tradecatch.ca

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Analytics only loads in the browser after the visitor accepts the cookie banner.
# Conversion events fired when consented: cta_click, audit_step_completed,
# audit_form_submitted, generate_lead.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend (https://resend.com) — audit-request confirmation + internal notification.
# Strongly recommended before a public audit-form demo. If unset, submissions
# are accepted and logged, but confirmation/internal notification email is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
RESEND_NOTIFY_EMAIL=you@example.com

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Site key is public (browser); secret key stays server-only.
# Strongly recommended before public traffic. If unset, verification is skipped
# with a warning; the health route reports the missing optional integration.
# Never commit real keys. If keys were ever committed, rotate them in the
# Cloudflare dashboard before relying on Turnstile in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional CRM / automation webhook (Zapier, Make, n8n, HubSpot, Airtable…).
# On each accepted book-audit lead, TradeCatch POSTs JSON to this URL.
LEADS_WEBHOOK_URL=
# Optional bearer token sent as Authorization: Bearer …
LEADS_WEBHOOK_SECRET=

# Optional calendar booking link shown after a successful audit request
# (Cal.com, Calendly, Google Appointment schedules, etc.).
NEXT_PUBLIC_CALENDAR_URL=

# Optional error monitoring webhook (Sentry/Better Stack/Slack/Discord incoming URL).
# Used by /api/client-error and server-side reportError(). Apply provider-side quotas.
ERROR_WEBHOOK_URL=
# Optional build stamp attached to client-error reports.
NEXT_PUBLIC_BUILD_ID=
# Cloudflare only: set to 1 after confirming the public origin is reachable only
# through Cloudflare. This trusts CF-Connecting-IP for per-client rate limits.
CF_TRUSTED=
# Other reverse proxies only: set to 1 when the proxy sanitizes
# X-Forwarded-For / X-Real-IP. Vercel is detected automatically.
TRUST_PROXY_HEADERS=

# Optional Upstash Redis (REST) for shared rate-limit + idempotency across
# multiple serverless instances. Without these, limits are per-instance only.
# https://upstash.com/docs/redis/overall/getstarted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SaaS portal (magic-link auth). Required to sign session cookies for /app.
# Prefer a dedicated secret; falls back to MISSED_CALL_OPS_SECRET if unset.
AUTH_SECRET=
# Set to 1 only on a loopback, non-production harness to return a clickable
# magic-link token when email delivery is unavailable.
SAAS_DEV_LOGIN=
# Optional: force durable SaaS store (otherwise uses MISSED_CALL_DURABLE_STORE).
SAAS_DURABLE_STORE=

# --- Module A: missed-call recovery (Twilio) ---
# Account credentials for outbound SMS. If unset, SMS is logged as dry-run.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public origin Twilio uses when signing webhooks (no trailing slash), e.g. https://tradecatch.ca
MISSED_CALL_PUBLIC_WEBHOOK_BASE=
# Set to 1 to skip X-Twilio-Signature checks (never in real production traffic).
MISSED_CALL_SKIP_TWILIO_VALIDATE=
# Local/manual test switch for /api/missed-call/sandbox. Production readiness
# rejects deployments with this enabled.
MISSED_CALL_SANDBOX=
# Comma-separated backup technician phones (escalated in order).
MISSED_CALL_TECH_BACKUP_PHONES=
MISSED_CALL_TECH_OWNER_PHONE=
MISSED_CALL_TECH_OWNER_NAME=
MISSED_CALL_HUMAN_REVIEW_PHONE=
MISSED_CALL_TIMEZONE=America/Toronto
# Full JSON ClientAccount override (takes precedence over the individual vars).
MISSED_CALL_CLIENT_CONFIG_JSON=
# Set to 1 only for intentional demo routing in non-production-like hosts.
MISSED_CALL_ALLOW_DEMO=
# Set to dry-run to force the explicit fake SMS adapter outside production.
# Production never returns fake SM_dry_* success SIDs — missing Twilio throws.
MISSED_CALL_SMS_MODE=
# Optional Postgres URL for the durable MissedCallStore adapter.
# Run `npm run db:schema` to apply the base schema and every migration through
# 005_crm_webhook_dlq, then set MISSED_CALL_DURABLE_STORE=1.
DATABASE_URL=
# Set to 1 only after `npm run db:schema` succeeds and createPostgresStore() should run.
MISSED_CALL_DURABLE_STORE=
# Bearer token for Module A ops APIs (leads, escalations/tick, sandbox).
# Also accepts CRON_SECRET as a scheduler compatibility alias.
# REQUIRED in production — endpoints return 401 without a matching bearer.
MISSED_CALL_OPS_SECRET=
# Optional compatibility alias used by the scheduler when the ops secret is unset.
CRON_SECRET=
# Single-tenant v1 client config
MISSED_CALL_CLIENT_ID=client_demo
MISSED_CALL_SMS_FROM=+15145550100
MISSED_CALL_TECH_PHONE=+15145550199
MISSED_CALL_TECH_NAME=Technicien de garde
MISSED_CALL_CONTRACTOR_NAME=Nord Plomberie
