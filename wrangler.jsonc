{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "tradecatch",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Production values are founder-managed in the Cloudflare dashboard for the
  // first pilot. Preserve plaintext vars on deploy; Wrangler already preserves
  // secrets. Staging overrides live under env.staging (separate Worker + DB).
  "keep_vars": true,
  "triggers": {
    "crons": ["* * * * *", "*/15 * * * *", "15 6 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tradecatch",
    },
  ],
  "env": {
    // Isolated staging / demo Worker. Deploy with:
    //   npm run deploy:staging
    // Set secrets via `wrangler secret put --env staging <NAME>` (never commit).
    // Required secrets/vars are documented in docs/STAGING_ENVIRONMENT.md.
    "staging": {
      "name": "tradecatch-staging",
      "triggers": {
        "crons": ["* * * * *", "*/15 * * * *", "15 6 * * *"],
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "tradecatch-staging",
        },
      ],
      "vars": {
        "TRADECATCH_ENV": "staging",
        "NEXT_PUBLIC_TRADECATCH_ENV": "staging",
        "NEXT_PUBLIC_DEMO_MODE": "1",
        "MISSED_CALL_SANDBOX": "1",
        "MISSED_CALL_ALLOW_DEMO": "1",
        "MISSED_CALL_SMS_MODE": "dry-run",
        "MISSED_CALL_DURABLE_STORE": "1",
        "SAAS_DEV_LOGIN": "0",
      },
    },
  },
}
