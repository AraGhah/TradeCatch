# Where TradeCatch is deployed (no trailing slash).
TRADECATCH_BASE_URL=https://tradecatch.ca

# Same value as MISSED_CALL_OPS_SECRET in the TradeCatch deployment.
# Set it as a LiveKit Cloud secret, never in git:
#   lk agent update-secrets --secrets "TRADECATCH_OPS_SECRET=..."
TRADECATCH_OPS_SECRET=

# --- Voice and turn-taking (all optional; out-of-range values are ignored) ---
# Realtime speech-to-speech model and voice. The model must be a realtime audio model:
# gpt-6-luna takes text and image only, so it is used for the cloned-voice language model below, not here.
# AGENT_REALTIME_MODEL=openai/gpt-live-1
# AGENT_VOICE=marin
# How long the agent waits after the caller stops talking before it answers
# (seconds), and the longest it waits for a caller who is still thinking.
# AGENT_ENDPOINTING_MODE=dynamic          # "fixed" or "dynamic"
# AGENT_MIN_ENDPOINTING_DELAY=0.5         # 0.1 - 3
# AGENT_MAX_ENDPOINTING_DELAY=3.0         # 0.5 - 8
# Can the caller cut the agent off, and how much speech counts as doing so.
# AGENT_INTERRUPTIONS=true
# AGENT_INTERRUPTION_MIN_DURATION=0.5     # seconds, 0.1 - 2
# AGENT_INTERRUPTION_MIN_WORDS=0          # 0 - 5
# Start composing the reply before the caller's turn is final (lower latency).
# AGENT_PREEMPTIVE_GENERATION=true

# --- Call transfers (see README, "Transfers") ---
# auto (default): warm when an outbound trunk is set, otherwise SIP REFER. Also: warm | blind | off.
# AGENT_TRANSFER_MODE=auto
# The LiveKit OUTBOUND SIP trunk used to ring the contractor (`lk sip outbound create ...`).
# As a LiveKit secret, never in git:
#   lk agent update-secrets --secrets "LIVEKIT_SIP_OUTBOUND_TRUNK=ST_..."
# LIVEKIT_SIP_OUTBOUND_TRUNK=
# Caller ID shown on the contractor's phone (E.164). Must be a Twilio number or verified
# caller ID on the account. Unset: the business's own number is shown (trunk numbers: ["*"]).
# LIVEKIT_SIP_NUMBER=+14385550100
# How long the contractor's phone rings (10 - 60), how long they have to say yes or press 1
# after answering (15 - 120), and the longest the caller is kept waiting in total (30 - 240).
# AGENT_TRANSFER_RING_SECONDS=25
# AGENT_TRANSFER_CONSULT_SECONDS=45
# AGENT_TRANSFER_BUDGET_SECONDS=100

# --- TradeCatch API timeouts in seconds (1 - 60) ---
# AGENT_CONFIG_TIMEOUT_SECONDS=4
# AGENT_AVAILABILITY_TIMEOUT_SECONDS=9
# AGENT_BOOK_TIMEOUT_SECONDS=9

# --- Custom voice (Receptionist Plus businesses that cloned their own voice) ---
# Needed to speak with a cloned voice. As a LiveKit secret, never in git:
#   lk agent update-secrets --secrets "ELEVENLABS_API_KEY=..."
# Without it every call uses the standard voice above.
# ELEVENLABS_API_KEY=
# "false" is a kill switch: standard voice for every business.
# AGENT_CUSTOM_VOICE=true
# Speech-to-text and language model for cloned-voice calls (LiveKit Inference ids).
# AGENT_CUSTOM_VOICE_STT=deepgram/nova-3
# AGENT_CUSTOM_VOICE_LLM=openai/gpt-6-luna
# Spoken instead if ElevenLabs fails mid-call ("provider/model" or "provider/model:voice").
# AGENT_FALLBACK_TTS=cartesia/sonic-3
