# Where TradeCatch is deployed (no trailing slash).
TRADECATCH_BASE_URL=https://tradecatch.ca

# Same value as MISSED_CALL_OPS_SECRET in the TradeCatch deployment.
# Set it as a LiveKit Cloud secret, never in git:
#   lk agent update-secrets --secrets "TRADECATCH_OPS_SECRET=..."
TRADECATCH_OPS_SECRET=

# Only for local `python agent.py console` testing, where there is no SIP caller.
# DEFAULT_BUSINESS_NUMBER=+14382314700

# --- Voice and turn-taking (all optional; out-of-range values are ignored) ---
# Realtime speech-to-speech model and voice.
# AGENT_REALTIME_MODEL=openai/gpt-live-1
# AGENT_VOICE=marin
# How long the agent waits after the caller stops talking before it answers
# (seconds), and the longest it waits for a caller who is still thinking.
# AGENT_ENDPOINTING_MODE=dynamic          # "fixed" or "dynamic"
# AGENT_MIN_ENDPOINTING_DELAY=0.5         # 0.1 - 3
# AGENT_MAX_ENDPOINTING_DELAY=3.0         # 0.5 - 8
# Can the caller cut the agent off, and how much speech counts as doing so.
# AGENT_INTERRUPTIONS=true
# AGENT_INTERRUPTION_MIN_DURATION=0.5     # seconds, 0.1 - 2
# AGENT_INTERRUPTION_MIN_WORDS=0          # 0 - 5
# Start composing the reply before the caller's turn is final (lower latency).
# AGENT_PREEMPTIVE_GENERATION=true

# --- TradeCatch API timeouts in seconds (1 - 60) ---
# AGENT_CONFIG_TIMEOUT_SECONDS=4
# AGENT_AVAILABILITY_TIMEOUT_SECONDS=9
# AGENT_BOOK_TIMEOUT_SECONDS=9
