{
  "name": "tradecatch-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "postinstall": "node scripts/patch-opennext-windows.js && node scripts/patch-opennext-preview-props.js",
    "format": "prettier --write \"src/product/missed-call/**/*.{ts,tsx}\" \"src/lib/**/*.{ts,tsx}\" \"src/app/api/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/product/missed-call/**/*.{ts,tsx}\" \"src/lib/**/*.{ts,tsx}\" \"src/app/api/**/*.{ts,tsx}\"",
    "db:schema": "node scripts/apply-missed-call-schema.js",
    "db:migrate-native-sales-crm": "node scripts/migrate-native-sales-crm.js",
    "db:lockdown": "node scripts/lockdown-data-api.js",
    "db:reset-admin-mfa": "node scripts/reset-admin-mfa.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore-drill": "node scripts/db-restore-drill.js",
    "db:seed:staging": "node scripts/seed-staging-demo.js",
    "check:i18n": "node scripts/check-i18n-parity.js",
    "check:module-a": "tsx scripts/check-module-a-readiness.ts",
    "agent-tools:mcp": "tsx scripts/agent-tools-mcp-server.ts",
    "evals:agents": "tsx scripts/run-agent-evals.ts",
    "check:legal": "node scripts/check-legal-placeholders.js",
    "check:media": "node scripts/check-repo-media.js",
    "check:dev-audit": "node scripts/check-dev-audit-exceptions.js",
    "check:secrets": "node scripts/check-secrets.js",
    "check:brace-expansion": "node scripts/check-brace-expansion.js",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:qa": "tsx --test tests/qa/*.test.ts",
    "test:e2e": "playwright test",
    "build:cloudflare": "node scripts/clear-open-next.js && opennextjs-cloudflare build",
    "check:cloudflare-bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check:cloudflare-bundle:staging": "wrangler deploy --env staging --dry-run --outdir .wrangler/dry-run-staging",
    "preview": "node scripts/clear-open-next.js && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/release-cloudflare.js deploy",
    "deploy:staging": "node scripts/release-cloudflare.js deploy --staging",
    "upload": "node scripts/release-cloudflare.js upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --env-file scripts/wrangler-types.env",
    "cf-typecheck": "wrangler types --check --env-interface CloudflareEnv --env-file scripts/wrangler-types.env",
    "check:release": "node scripts/require-green-ci.js"
  },
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@swc/helpers": "0.5.23",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "jose": "^6.2.13",
    "next": "^16.4.3",
    "next-intl": "^4.13.2",
    "pg": "^8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "^8.5.10",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "glob@10": "10.5.0",
    "source-map-js": "1.2.2",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  }
}
