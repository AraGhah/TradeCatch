{
  "name": "tradecatch-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/product/missed-call/store.ts\" \"src/product/missed-call/types.ts\"",
    "format:check": "prettier --check \"src/product/missed-call/store.ts\" \"src/product/missed-call/types.ts\"",
    "check:i18n": "node scripts/check-i18n-parity.js",
    "check:legal": "node scripts/check-legal-placeholders.js",
    "check:media": "node scripts/check-repo-media.js",
    "check:dev-audit": "node scripts/check-dev-audit-exceptions.js",
    "check:brace-expansion": "node scripts/check-brace-expansion.js",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "next": "^16.2.12",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.10",
    "brace-expansion@1": "1.1.17",
    "brace-expansion@5": "5.0.8",
    "minimatch@3": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.8"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
